# /etc/autoform-panel/env  (root:autoform-panel 0640) — values copied from the former Cloudflare Worker
# "anker-form-admin" bindings. Lines are KEY=VALUE; no shell interpolation.

LISTEN_HOST=127.0.0.1
LISTEN_PORT=18788

# --- plain vars (from Cloudflare) ---
PUBLIC_URL=https://anker.besender.lyp04.com
GITHUB_REPO=lyp04/anker-form-catalog
BACKEND_API_BASE=https://api2.besender.com/api
CATALOG_STORAGE_MODE=r2
APP_PAIR_APPLICATION_IDS=com.autoformkit.app
APP_PAIR_TTL_SECONDS=300
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=deepseek/deepseek-chat-v3-0324

# --- version metadata (what CF_VERSION_METADATA reported on Cloudflare; update on redeploy) ---
VERSION_ID=6476691d-3601-4ace-9d3f-196062736185
SOURCE_COMMIT=98caef755e7c469e210e9cc7651cc7a3df997a3d
VERSION_TAG=autoform-source-98caef755e7c469e210e9cc7651cc7a3df997a3d
VERSION_TIMESTAMP=2026-08-21T18:22:45.771187Z

# --- secrets (Cloudflare never exposes these; paste the same values used on the Worker) ---
AI_API_KEY=
APP_PAIR_ISSUER_KEY=
BACKEND_SESSION_PROOF_CODES=
CATALOG_READ_KEY=
GITHUB_TOKEN=
