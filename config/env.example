# Copy to config/env and fill in. KEY=value, one per line, no shell interpolation.
# Point the service at this file with AUTOFORM_ENV_FILE (see config/autoform-server.service).

# --- server ---
LISTEN_HOST=127.0.0.1
LISTEN_PORT=18788
# DATA_DIR=./data          # defaults to <project>/data

# --- public origin (required) ---
PUBLIC_URL=https://panel.example.com


# --- backend the operators log in to ---
BACKEND_API_BASE=https://api.example.com/api
# Required to bootstrap the panel: a real backend adapter (see config/backend-adapter.example.json).
# Paste it as one line, or configure it in the catalog settings after first login.
BACKEND_ADAPTER_JSON=

# --- app pairing ---
APP_PAIR_APPLICATION_IDS=com.example.app
APP_PAIR_TTL_SECONDS=300

# --- AI drafting (optional; leave blank to disable) ---
AI_BASE_URL=https://your-llm-endpoint/v1
AI_MODEL=your-model

# --- provenance (optional, informational) ---
VERSION_ID=
VERSION_TAG=
VERSION_TIMESTAMP=
SOURCE_COMMIT=

# --- secrets (do not commit real values) ---
CATALOG_READ_KEY=
APP_PAIR_ISSUER_KEY=
AI_API_KEY=
BACKEND_SESSION_PROOF_CODES=
